{
  "name": "@deepseek-ai/dsh-beardy",
  "description": "The Beardy agent bundle: persistent session search, history tools, SearXNG web search, web fetching, and the Beardy persona over dsh-base and dsh-web-app",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/beardy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "presets/beardy.patch.yml",
    "presets/beardy-unattended.patch.yml",
    "presets/beardy-discord.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/beardy.patch.yml",
        "./presets/beardy-unattended.patch.yml",
        "./presets/beardy-discord.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-cron": "workspace:*",
    "@deepseek-ai/dsh-discord-gateway": "workspace:*",
    "@deepseek-ai/dsh-fantasy": "workspace:*",
    "@deepseek-ai/dsh-fantasy-yahoo": "workspace:*",
    "@deepseek-ai/dsh-health": "workspace:*",
    "@deepseek-ai/dsh-local-model-control": "workspace:*",
    "@deepseek-ai/dsh-log-exporter": "workspace:*",
    "@deepseek-ai/dsh-tool-weather": "workspace:*",
    "@deepseek-ai/dsh-subagent-dsh-sdk": "workspace:*",
    "@deepseek-ai/dsh-research": "workspace:*",
    "@deepseek-ai/dsh-research-local": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-time-context": "workspace:*",
    "@deepseek-ai/dsh-tool-discord": "workspace:*",
    "@deepseek-ai/dsh-tool-fantasy": "workspace:*",
    "@deepseek-ai/dsh-tool-memory": "workspace:*",
    "@deepseek-ai/dsh-tool-odysseus-research": "workspace:*",
    "@deepseek-ai/dsh-tool-research": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-web-search-searxng": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "js-yaml": "^4.1.0"
  }
}
